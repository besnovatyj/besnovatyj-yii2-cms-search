{
  "name": "besnovatyj/yii2-cms-search",
  "description": "Фасад сквозного поиска по сайту для Yii2 CMS: собирает контент модулей через контракт SearchableProvider в единый каталог документов и рисует выдачу. Движок поиска (TNTSearch, Manticore, ...) подключается отдельным пакетом-ядром и переключается в настройках.",
  "type": "yii2-extension",
  "license": "MIT",
  "authors": [
    {
      "name": "Besnovatyj",
      "email": "your-email@example.com"
    }
  ],
  "minimum-stability": "stable",
  "extra": {
    "moduleClass": "Besnovatyj\\Search\\Module",
    "moduleId": "Search",
    "bescms": { "kind": "module" },
    "config-plugin": {
      "admin-menu": "src/config/adminMenu.php",
      "common": "src/config/common.php"
    }
  },
  "keywords": [
    "yii2",
    "cms",
    "search",
    "fulltext",
    "facade"
  ],
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    },
    "fxp-asset": {
      "enabled": false
    }
  },
  "require": {
    "php": ">=8.4",
    "ext-mbstring": "*",
    "yiisoft/yii2": "~2.0.0",
    "yiisoft/yii2-bootstrap5": "~2.0.0",
    "besnovatyj/yii2-cms-kernel": "^1.0",
    "besnovatyj/yii2-cms-contracts": "^1.0",
    "besnovatyj/yii2-cms-forms": "^1.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "Besnovatyj\\Search\\": "src/"
    }
  }
}
